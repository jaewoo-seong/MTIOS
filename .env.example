DATABASE_URL=
REDIS_URL=
LITELLM_BASE_URL=http://litellm.railway.internal:4000
LITELLM_API_KEY=
LITELLM_EMBEDDING_ROUTE=multilingual_embedding
EXECUTIVE_MODEL=openrouter/openai/gpt-5.6-terra
# OpenRouter/LiteLLM route for GPT-5.6 Luna, used only after free-route failure.
PREMIUM_FALLBACK_MODEL=openrouter/openai/gpt-5.6-luna
AUTO_LUNA_FALLBACK=true
OPENROUTER_FREE_RESEARCH_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FREE_LONGFORM_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FREE_MULTILINGUAL_MODEL=openrouter/google/gemma-4-31b-it:free
OPENROUTER_FREE_STRUCTURED_MODEL=openrouter/google/gemma-4-26b-a4b-it:free
OPENROUTER_FREE_FAST_MODEL=openrouter/nvidia/nemotron-nano-9b-v2:free
AUTH_SESSION_SECRET=
ADMIN_USERNAME=operator
ADMIN_PASSWORD=
NVIDIA_API_KEY=
NVIDIA_WORKER_MODEL=
NVIDIA_EMBEDDING_MODEL=
NVIDIA_RERANKING_MODEL=
NVIDIA_PRODUCTION_APPROVED=false
OPENROUTER_API_KEY=
ORGANIZATION_BUDGET_CENTS=
MCP_SERVICE_URL=http://mcp-tools.railway.internal:3002/mcp
MCP_SERVICE_SECRET=
DOCUMENT_CONVERSION_SERVICE_URL=http://document-conversion.railway.internal:3003
DOCUMENT_CONVERSION_SERVICE_SECRET=
RESEARCH_USER_AGENT=MTI-Business-OS/1.0 (contact: operator@example.com)
RESEARCH_CONTACT_EMAIL=
TAVILY_API_KEY=
TAVILY_API_KEY_BACKUP=
TAVILY_API_KEY_3=
FIRECRAWL_API_KEY=
FIRECRAWL_API_KEY_2=
FIRECRAWL_API_KEY_3=
OPENDART_API_KEY=
SAM_GOV_API_KEY=
FRED_API_KEY=
CENSUS_API_KEY=
KOREAN_PUBLIC_DATA_SERVICE_KEY=
KOREAN_PUBLIC_DATA_ENDPOINT=
KOSIS_API_KEY=
KOSIS_API_ENDPOINT=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
# Required for every Trigger.dev task that touches Postgres or calls a model.
# lib/workflows/callback.ts and lib/ai/litellm.ts both read this pair; with
# either missing, callWorkflowApp throws and requestModel silently bypasses
# cost tracking, budget enforcement, and premium-fallback approval. Point
# BUSINESS_OS_INTERNAL_URL at this app's own origin as the worker sees it.
BUSINESS_OS_INTERNAL_URL=http://localhost:3000
WORKFLOW_CALLBACK_SECRET=
RAILWAY_BUCKET_ENDPOINT=
RAILWAY_BUCKET_NAME=
RAILWAY_BUCKET_ACCESS_KEY_ID=
RAILWAY_BUCKET_SECRET_ACCESS_KEY=
APP_URL=http://localhost:3000

# Public conversational MCP gateway. Use distinct 32+ character secrets and
# keep BUSINESS_OS_INTERNAL_URL on Railway private networking in production.
EXTERNAL_MCP_GATEWAY_SECRET=replace-with-a-distinct-32-character-secret
EXTERNAL_MCP_ALLOWED_HOSTS=localhost
EXTERNAL_MCP_ALLOWED_ORIGINS=
# Maximum time the public MCP gateway waits for the private Business OS app.
# Clamped to 25-60000ms; keep below the public platform request timeout.
EXTERNAL_MCP_INTERNAL_TIMEOUT_MS=15000
# Local visual/interaction QA only. Set both values together. Production
# startup rejects UI_AUDIT_MODE=true, and NEXT_PUBLIC_UI_AUDIT_MODE only
# controls the visible entry button/banner; it grants no server access.
UI_AUDIT_MODE=false
NEXT_PUBLIC_UI_AUDIT_MODE=false
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GMAIL_TOKEN_ENCRYPTION_KEY=
# Optional HTTP Basic gate in front of the entire deployment, enforced in
# middleware.ts. Active only when BOTH are set, so leaving them blank changes
# nothing. Intended for staging and preview deployments, where the point is to
# keep scanners and search engines away from the login page; it is a perimeter
# on top of session auth, not a replacement for it. /api/health and
# /api/internal/** are exempt so platform health probes and Trigger.dev
# callbacks keep working.
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASSWORD=
